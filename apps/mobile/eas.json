{
  "cli": {
    "version": ">= 12.0.0",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "STELLAR_NETWORK": "testnet",
        "APP_VERSION": "0.1.0"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "STELLAR_NETWORK": "testnet",
        "APP_VERSION": "0.1.0"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "STELLAR_NETWORK": "mainnet"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
