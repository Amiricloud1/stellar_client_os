# ============================================
# REQUIRED: Smart Contract Configuration
# ============================================
# These contract IDs are REQUIRED for the app to function
# Must be valid Stellar contract addresses starting with 'C'
# Get these from your deployment or use the values from deployments/testnet.json

NEXT_PUBLIC_PAYMENT_STREAM_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
NEXT_PUBLIC_DISTRIBUTOR_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Planter/Referral contract (optional - enables referral rewards feature)
# Get this from your deployment or use the values from deployments/testnet.json
NEXT_PUBLIC_PLANTER_CONTRACT_ID=
# Optional Soroban token contracts accepted by escrow streams.
NEXT_PUBLIC_USDT_CONTRACT_ID=
NEXT_PUBLIC_EURC_CONTRACT_ID=

# ============================================
# REQUIRED: Stellar Network Configuration
# ============================================
# Network: 'testnet' or 'mainnet'
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint for contract interactions
# Default: https://soroban-testnet.stellar.org (for testnet)
# Mainnet: https://soroban-mainnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (must match the network)
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ============================================
# OPTIONAL: Application Metadata
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fundable Stellar
NEXT_PUBLIC_APP_DESCRIPTION=Stellar client for Fundable Protocol

# ============================================
# OPTIONAL: Backend API
# ============================================
# Leave empty if not using a backend API
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_BASE_URL=

# ============================================
# OPTIONAL: Error tracking (Sentry)
# ============================================
# Public DSN used by browser, server, and edge error reporting.
# Leave empty to disable Sentry while retaining the local error fallback.
NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload settings for CI only. Never commit the auth token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================
# OPTIONAL: Additional Stellar Services
# ============================================
# Horizon API endpoint (for account/transaction history)
# Leave empty to use default based on network
# Also probed by GET /api/healthz — the endpoint returns 503 when Horizon is unreachable.
NEXT_PUBLIC_STELLAR_HORIZON_URL=

# ============================================
# OPTIONAL: Impact estimation (server-side)
# ============================================
# Estimated CO2 offset (kg CO2e) per 1 USD funded, used by the analytics
# gateway (/api/graphql → sponsorImpact) to translate funding volume into
# an approximate climate impact figure. Defaults to 1 when unset.
CO2_PER_USD_KG=

# Admin API (issue #928): bearer key for /api/admin/* endpoints.
# Admin endpoints return 503 until this is set.
# Also used as the privileged-route credential for the API auth policy
# (issues #54/#56): privileged routes require this key; authenticated
# routes require a valid session/API token; public routes need neither.
ADMIN_API_KEY=

# Campaign progress cache (issue #908): TTL in seconds for cached
# GET /api/campaigns/[id]/progress metrics. Defaults to 300 (5 minutes).
CAMPAIGN_PROGRESS_CACHE_TTL_SECONDS=300

# ============================================
# OPTIONAL: API rate limiting (issue #56)
# ============================================
# Comma-separated list of trusted reverse-proxy IPs/CIDRs. When set, the
# client identity for rate limiting is derived from X-Forwarded-For only
# for requests arriving from these proxies; otherwise the socket peer
# address is used. Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# Per-route-class rate-limit overrides. Each class has a single unified
# policy; unset values fall back to the built-in defaults shown below.
# All limits are expressed as "requests per window" with a window in seconds.
#   public        -> RATE_LIMIT_PUBLIC_REQUESTS / RATE_LIMIT_PUBLIC_WINDOW_SECONDS
#   authenticated -> RATE_LIMIT_AUTH_REQUESTS / RATE_LIMIT_AUTH_WINDOW_SECONDS
#   privileged    -> RATE_LIMIT_PRIVILEGED_REQUESTS / RATE_LIMIT_PRIVILEGED_WINDOW_SECONDS
RATE_LIMIT_PUBLIC_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=120
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PRIVILEGED_REQUESTS=30
RATE_LIMIT_PRIVILEGED_WINDOW_SECONDS=60

# ============================================
# CONTRIBUTOR / OPERATOR NOTES (issues #54, #55, #56, #69)
# ============================================
# Route classification (#54): every API route is classified as one of
#   - public:        no credentials required.
#   - authenticated: requires a valid session/API token; missing or invalid
#                    credentials return 401, insufficient role returns 403.
#   - privileged:    requires ADMIN_API_KEY (or an admin role); returns 503
#                    when the key is unset and 401/403 otherwise.
# Policy checks are shared across routes; add negative tests for missing and
# invalid roles when introducing new endpoints.
#
# Input validation (#55): path, query, and body values are validated with
# shared schemas. Unknown or invalid inputs are rejected consistently with
# 400 responses; add boundary tests for each new schema.
#
# Rate limiting (#56): one route-class policy governs limits. Responses
# include standard RateLimit-* headers (and Retry-After on 429). Identity
# keys are derived atomically from the trusted-proxy-aware client address.
#
# Webhook secrets (#69): subscription secrets are revealed only in the
# creation response. Cross-account access is denied; secrets can be rotated
# and subscriptions revoked. Tests cover rotation, revocation, and account
# isolation.
=======
