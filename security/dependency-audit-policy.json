{
  "version": "1.0.0",
  "vulnerabilityPolicy": {
    "failOnSeverity": "high",
    "maxSuppressionDays": 90,
    "remediationSlaDays": {
      "critical": 1,
      "high": 7,
      "moderate": 30,
      "low": 90,
      "info": 180
    }
  },
  "licensePolicy": {
    "allowedLicenses": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "0BSD",
      "CC0-1.0",
      "Unlicense",
      "Zlib",
      "BlueOak-1.0.0",
      "CC-BY-3.0",
      "CC-BY-4.0",
      "Unicode-3.0",
      "Unicode-DFS-2016",
      "Python-2.0",
      "MPL-2.0"
    ],
    "deniedLicenses": [
      "GPL-2.0",
      "GPL-2.0-only",
      "GPL-2.0-or-later",
      "GPL-3.0",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "AGPL-3.0",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "SSPL-1.0",
      "BSL-1.1",
      "UNLICENSED"
    ],
    "failOnUnknownLicense": true
  },
  "ownership": {
    "defaultOwner": "@Fundable-Protocol/security",
    "ecosystems": {
      "pnpm": "@Fundable-Protocol/frontend-sdk-team",
      "cargo": "@Fundable-Protocol/contracts-team"
    },
    "packages": {
      "@fundable/web": "@Fundable-Protocol/web-team",
      "@fundable/sdk": "@Fundable-Protocol/sdk-team",
      "@fundable/mobile": "@Fundable-Protocol/mobile-team",
      "contracts/*": "@Fundable-Protocol/contracts-team"
    }
  },
  "suppressions": []
}
